<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_asterisk"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Sesión de Claude activa"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <Chronometer
        android:id="@+id/chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:textColor="@color/claude_coral"
        android:textSize="44sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:text="hasta restablecer tu límite"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"/>

    <!-- Uso real -->
    <LinearLayout
        android:id="@+id/usageBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/lblSessionN"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sesión 5 h"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>
            <TextView
                android:id="@+id/pctSessionN"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/claude_coral"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/barSessionN"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="4dp"
            android:max="100" android:progress="0"
            android:progressDrawable="@drawable/progress_rounded"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Semanal"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>
            <TextView
                android:id="@+id/pctWeeklyN"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/claude_coral"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/barWeeklyN"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="4dp"
            android:max="100" android:progress="0"
            android:progressDrawable="@drawable/progress_rounded"/>

        <TextView
            android:id="@+id/lastConsumeN"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/btn_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:text="↺  Reiniciar"
            android:textColor="@color/on_coral"
            android:textStyle="bold"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"/>

        <TextView
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_btn_ghost"
            android:text="✕  Finalizar"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"/>
    </LinearLayout>
</LinearLayout>
