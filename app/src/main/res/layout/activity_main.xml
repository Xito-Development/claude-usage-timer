<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/app_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabecera -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_asterisk"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Temporizador de Claude"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Estado / cuenta atrás -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/stateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sin sesión activa"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="--:--:--"
                android:textColor="@color/claude_coral"
                android:textSize="52sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"/>

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="14dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/claude_coral"/>
        </LinearLayout>

        <!-- Selector de tiempo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cuándo se restablece"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/modeHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Elige cuánto quieres que dure la cuenta atrás"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>

            <!-- Selector de modo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <TextView android:id="@+id/modeDuration" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Duración" android:gravity="center"
                    android:background="@drawable/bg_chip" android:textColor="@color/claude_coral"
                    android:textStyle="bold" android:paddingTop="10dp" android:paddingBottom="10dp"/>
                <TextView android:id="@+id/modeClock" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Hora exacta" android:gravity="center"
                    android:background="@drawable/bg_chip" android:textColor="@color/claude_coral"
                    android:textStyle="bold" android:paddingTop="10dp" android:paddingBottom="10dp"/>
            </LinearLayout>

            <!-- Atajos -->
            <LinearLayout
                android:id="@+id/rowChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">
                <TextView android:id="@+id/chip5" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="5h" android:gravity="center"
                    android:background="@drawable/bg_chip" android:textColor="@color/claude_coral"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>
                <TextView android:id="@+id/chip4" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:text="4h" android:gravity="center"
                    android:background="@drawable/bg_chip" android:textColor="@color/claude_coral"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>
                <TextView android:id="@+id/chip3" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:text="3h" android:gravity="center"
                    android:background="@drawable/bg_chip" android:textColor="@color/claude_coral"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>
                <TextView android:id="@+id/chip2" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:text="2h" android:gravity="center"
                    android:background="@drawable/bg_chip" android:textColor="@color/claude_coral"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>
                <TextView android:id="@+id/chip1" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:text="1h" android:gravity="center"
                    android:background="@drawable/bg_chip" android:textColor="@color/claude_coral"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>
            </LinearLayout>

            <!-- Selectores horas/minutos -->
            <LinearLayout
                android:id="@+id/rowPickers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_inner"
                android:padding="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <NumberPicker android:id="@+id/pickHours"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="horas" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <NumberPicker android:id="@+id/pickMinutes"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="minutos" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Hora exacta de reinicio -->
            <LinearLayout
                android:id="@+id/rowClock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_inner"
                android:padding="8dp">
                <TimePicker
                    android:id="@+id/timePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:timePickerMode="spinner"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="hora a la que se restablece tu límite"
                    android:textColor="@color/text_secondary" android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Botón principal -->
        <TextView
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶  Comenzar sesión"
            android:textColor="@color/on_coral"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/bg_btn_primary"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"/>

        <!-- Botones secundarios -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <TextView android:id="@+id/btnReset" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="↺  Reiniciar" android:gravity="center"
                android:background="@drawable/bg_btn_ghost" android:textColor="@color/text_primary"
                android:paddingTop="13dp" android:paddingBottom="13dp"/>
            <TextView android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="10dp" android:text="✕  Finalizar"
                android:gravity="center" android:background="@drawable/bg_btn_ghost"
                android:textColor="@color/text_secondary" android:paddingTop="13dp" android:paddingBottom="13dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnShow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="🔔  Dejar notificación siempre activa"
            android:gravity="center"
            android:background="@drawable/bg_btn_ghost"
            android:textColor="@color/text_primary"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:text="Xito Development"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
