<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:padding="15dp">

    <!-- Cabecera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_asterisk"/>

        <TextView
            android:id="@+id/wState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:text="modo manual"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:maxLines="1"/>

        <ImageView
            android:id="@+id/wRefresh"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_refresh"/>
    </LinearLayout>

    <!-- Cuenta atrás -->
    <TextView
        android:id="@+id/wTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="--:--"
        android:textColor="@color/claude_coral"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="-0.03"
        android:fontFamily="sans-serif-medium"/>

    <TextView
        android:id="@+id/wLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="sin sesión"
        android:textColor="@color/text_tertiary"
        android:textSize="10sp"/>

    <ProgressBar
        android:id="@+id/wBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="9dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/progress_rounded"/>

    <!-- Uso real -->
    <LinearLayout
        android:id="@+id/wUsageRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="9dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/wPct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="sesión usada"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/wWeekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="semanal"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/wLast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/claude_coral"
                android:textSize="15sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="último gasto"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/wSync"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text=""
        android:textColor="@color/text_tertiary"
        android:textSize="9sp"/>
</LinearLayout>
